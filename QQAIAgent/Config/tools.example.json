[
  {
    "Name": "set_reasoning_effort",
    "TimeoutSeconds": 5,
    "Description": "设置下一次模型请求的思考强度。每条新用户消息从 minimal 开始；需要更强推理时调用，能回答时直接回答。不调用则保留当前强度，也可按后续任务需要降低强度。可与普通工具同时调用，同轮多次设置以最后一次有效设置为准。档位由低到高为 minimal、low、medium、high、max，实际参数由模型类库映射。",
    "ParametersJson": "{\"type\":\"object\",\"properties\":{\"effort\":{\"type\":\"string\",\"enum\":[\"minimal\",\"low\",\"medium\",\"high\",\"max\"]}},\"required\":[\"effort\"],\"additionalProperties\":false}",
    "Enabled": true
  },
  {
    "Name": "get_time",
    "TimeoutSeconds": 5,
    "Description": "获取当前日期和时间。",
    "ParametersJson": "{\"type\":\"object\",\"properties\":{}}",
    "Enabled": true
  },
  {
    "Name": "web_search",
    "TimeoutSeconds": 30,
    "Description": "通过联网搜索查询互联网信息，返回网页标题、摘要、来源地址和发布时间。",
    "ParametersJson": "{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\",\"description\":\"搜索关键词或问题\"}},\"required\":[\"query\"]}",
    "Enabled": false
  },
  {
    "Name": "fetch_web_page",
    "TimeoutSeconds": 60,
    "Description": "获取 HTTP 或 HTTPS 网页的静态正文，返回最终地址、标题和正文。不执行 JavaScript。",
    "ParametersJson": "{\"type\":\"object\",\"properties\":{\"url\":{\"type\":\"string\",\"description\":\"需要获取内容的网页地址\"}},\"required\":[\"url\"]}",
    "Enabled": false
  }
]
